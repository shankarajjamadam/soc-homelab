# Scenario 07 — C2 Beaconing — Splunk Detection Queries
# Lab: SOC Home Lab | Shankar Ajjamadam | June 2026
# Index: sysmon | Source: Sysmon via Splunk UF on Windows 10

# ─────────────────────────────────────────────────────────────
# DETECTION 1 — Outbound Connection to Non-Standard Port
# MITRE: T1071.001, T1095 | Severity: HIGH
# ─────────────────────────────────────────────────────────────
index=sysmon EventCode=3 DestinationPort=4444
| table _time, Image, SourceIp, DestinationIp, DestinationPort, ProcessId

# ─────────────────────────────────────────────────────────────
# DETECTION 2 — Beaconing Statistical Analysis
# MITRE: T1071.001 | Severity: CRITICAL
# Saved Alert: C2 Beaconing - Periodic Outbound Connection Detected
# ─────────────────────────────────────────────────────────────
index=sysmon EventCode=3 DestinationPort=4444
| bin _time span=1m
| stats count by _time, DestinationIp, DestinationPort
| eventstats stdev(count) as stdev, avg(count) as avg by DestinationIp
| where stdev < 0.5
| table _time, DestinationIp, DestinationPort, count, avg, stdev

# ─────────────────────────────────────────────────────────────
# DETECTION 3 — Full Process Correlation + Beaconing
# MITRE: T1059.001, T1071.001 | Severity: CRITICAL
# Saved Alert: C2 Beaconing - Process Correlation - CRITICAL
# ─────────────────────────────────────────────────────────────
index=sysmon EventCode=3 DestinationPort=4444
| rename ProcessId as pid
| join pid
    [search index=sysmon EventCode=1
    | rename ProcessId as pid
    | fields pid, Image, CommandLine, ParentImage, ParentCommandLine]
| where NOT match(Image, "(?i)splunk")
| bin _time span=1m
| stats count by _time, Image, CommandLine, ParentImage, DestinationIp, DestinationPort
| eventstats stdev(count) as stdev, avg(count) as avg by DestinationIp
| eval risk_score=case(
    DestinationPort=4444 AND stdev<1, "CRITICAL",
    DestinationPort=4444, "HIGH",
    true(), "MEDIUM")
| table _time, Image, CommandLine, ParentImage, DestinationIp, DestinationPort, count, avg, stdev, risk_score

# ─────────────────────────────────────────────────────────────
# DETECTION 4 — PowerShell Spawning Unsigned Binary
# MITRE: T1059.001 | Severity: HIGH
# ─────────────────────────────────────────────────────────────
index=sysmon EventCode=1 ParentImage="*powershell.exe*"
| where NOT match(Image, "(?i)(system32|syswow64|program files|splunk|windows defender)")
| table _time, Image, CommandLine, ParentImage, User

# ─────────────────────────────────────────────────────────────
# DETECTION 5 — Broad Non-Standard Outbound Port Alert
# MITRE: T1071 | Severity: MEDIUM
# ─────────────────────────────────────────────────────────────
index=sysmon EventCode=3
| where NOT (DestinationPort=80 OR DestinationPort=443 OR DestinationPort=8080
    OR DestinationPort=53 OR DestinationPort=445 OR DestinationPort=139
    OR DestinationPort=9997 OR DestinationPort=8000 OR DestinationPort=514)
| where NOT match(Image, "(?i)splunk")
| stats count by DestinationIp, DestinationPort, Image
| sort -count
| head 20
