# Scenario 04 — Directory Traversal / LFI — Splunk Detection Queries
# Lab: SOC Home Lab | Shankar Ajjamadam | May/June 2026
# Index: juiceshop | Sourcetype: nginx:juice-shop:json

# ─────────────────────────────────────────────────────────────
# DETECTION 1 — Path Traversal URI Pattern (Primary)
# MITRE: T1083 | Severity: HIGH
# Saved Alert: Directory Traversal - Path Traversal Pattern Detected
# ─────────────────────────────────────────────────────────────
index=juiceshop sourcetype="nginx:juice-shop:json"
| search uri="*../*" OR uri="*%2e%2e%2f*" OR uri="*%252e*" OR uri="*etc/passwd*" OR uri="*etc/shadow*"
| table _time, remote_addr, method, uri, status, bytes_sent

# ─────────────────────────────────────────────────────────────
# DETECTION 2 — Successful Traversal (200 Response)
# MITRE: T1005 | Severity: CRITICAL
# ─────────────────────────────────────────────────────────────
index=juiceshop sourcetype="nginx:juice-shop:json"
| search uri="*../*" OR uri="*%2e%2e%2f*" OR uri="*etc*" OR uri="*ftp*"
| where status=200
| table _time, remote_addr, uri, status, bytes_sent
| sort -bytes_sent

# ─────────────────────────────────────────────────────────────
# DETECTION 3 — Large Response to Suspicious URI (File Read)
# MITRE: T1005 | Severity: HIGH
# ─────────────────────────────────────────────────────────────
index=juiceshop sourcetype="nginx:juice-shop:json"
| where bytes_sent > 1000
| search uri="*ftp*" OR uri="*assets*" OR uri="*../*"
| table _time, remote_addr, uri, status, bytes_sent, request_time
| sort -bytes_sent

# ─────────────────────────────────────────────────────────────
# DETECTION 4 — Encoding Evasion Attempts
# MITRE: T1027 | Severity: HIGH
# ─────────────────────────────────────────────────────────────
index=juiceshop sourcetype="nginx:juice-shop:json"
| search uri="*%25*" OR uri="*%252e*" OR uri="*%2500*" OR uri="*%00*"
| table _time, remote_addr, uri, status, bytes_sent

# ─────────────────────────────────────────────────────────────
# DETECTION 5 — FTP Directory Exposure
# MITRE: T1190 | Severity: HIGH
# ─────────────────────────────────────────────────────────────
index=juiceshop sourcetype="nginx:juice-shop:json"
| search uri="/ftp/*"
| table _time, remote_addr, uri, status, bytes_sent
| sort -bytes_sent

# ─────────────────────────────────────────────────────────────
# DETECTION 6 — Traversal Attempt Volume by Source IP
# MITRE: T1083 | Severity: MEDIUM
# ─────────────────────────────────────────────────────────────
index=juiceshop sourcetype="nginx:juice-shop:json"
| search uri="*../*" OR uri="*%2e%2e*"
| stats count as attempts, values(uri) as uris by remote_addr
| where attempts > 3
| sort -attempts
