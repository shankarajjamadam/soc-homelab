# Splunk Master Correlation Search
# Multi-Stage MITRE ATT&CK Chain Detection
# Lab: SOC Home Lab — Attack Simulation
# Created: May 2026

# SEARCH QUERY
# Copy and paste the entire block below into Splunk Search

index=sysmon OR index=wineventlog OR index=main
| eval stage=case(
    /* Phase 1 — Reconnaissance: Network scan (SYN burst) */
    (index="sysmon" AND EventCode=3 AND SourceIp="10.10.10.5" AND DestinationIp="10.10.10.10"), "01_recon",
    
    /* Phase 2 — Initial Access: SMB brute force (failed logons) */
    (index="wineventlog" AND match(_raw, "<EventID>4625</EventID>")), "02_initial_access",
    
    /* Phase 3 — Execution: PowerShell IEX / Meterpreter shell */
    (index="sysmon" AND EventCode=1 AND match(Image, "powershell") AND match(CommandLine, "IEX")), "03_execution",
    
    /* Phase 4 — Privilege Escalation: fodhelper UAC bypass (registry write) */
    (index="sysmon" AND EventCode=13 AND match(TargetObject, "ms-settings.*Shell.*command")), "04_priv_esc",
    
    /* Phase 5 — Credential Access: LSASS process access (dump) */
    (index="sysmon" AND EventCode=10 AND match(TargetImage, "lsass") AND match(CallTrace, "comsvcs")), "05_cred_access",
    
    /* Phase 6 — Persistence: Registry Run key modification */
    (index="sysmon" AND EventCode=13 AND match(TargetObject, "CurrentVersion.*Run")), "06_persistence",
    
    /* Phase 7 — Defense Evasion: Event log clearing (EID 1102) */
    (index="wineventlog" AND match(_raw, "<EventID>1102</EventID>")), "07_defense_evasion",
    
    /* Phase 8 — Discovery: LOLBin enumeration (net, tasklist, whoami) */
    (index="sysmon" AND EventCode=1 AND match(Image, "(net|tasklist|whoami|systeminfo)\\.exe")), "08_discovery",
    
    /* Phase 9 — Collection: Archive creation (backup.zip in Public) */
    (index="sysmon" AND EventCode=11 AND match(TargetFilename, ".*Public.*\\.zip$")), "09_collection",
    
    /* Phase 10 — Exfiltration: Outbound HTTP POST to attacker */
    (index="sysmon" AND EventCode=3 AND DestinationIp="10.10.10.5" AND (DestinationPort=8444 OR DestinationPort=8443)), "10_exfil",
    
    /* Phase 11 — Impact: VSS deletion and file encryption indicators */
    (index="sysmon" AND EventCode=1 AND match(Image, "vssadmin\\.exe") AND match(CommandLine, "delete.*shadows")), "11_impact",
    
    true(), "noise")

/* Filter out non-malicious events */
| where stage != "noise"

/* Bucket events by hour for timeline correlation */
| bucket _time span=1h

/* Aggregate: count unique stages, list which stages fired, first/last seen times */
| stats 
    dc(stage) as stages_hit 
    values(stage) as stage_list 
    earliest(_time) as first_event 
    latest(_time) as last_event 
    count as total_events
    by host

/* Calculate chain duration */
| eval duration_minutes=round((last_event-first_event)/60, 1)

/* Alert only if 5+ distinct phases detected (reduces false positives) */
| where stages_hit >= 5

/* Enrich with detection metadata */
| eval detection_name="Multi-Stage MITRE Attack Chain Detected"
| eval severity="critical"
| eval tactic="Reconnaissance, Initial Access, Execution, Privilege Escalation, Credential Access, Persistence, Defense Evasion, Discovery, Collection, Exfiltration, Impact"

/* Sort by number of stages detected (highest first) */
| sort - stages_hit

/* Display results */
| table host, stages_hit, stage_list, total_events, duration_minutes, first_event, last_event, detection_name, severity


# ============================================
# INDIVIDUAL PHASE DETECTION QUERIES
# ============================================

# PHASE 1: Reconnaissance
# Alert on network connection bursts from external source
index=sysmon host=DESKTOP-LGU5NRB EventCode=3 SourceIp=10.10.10.5 DestinationIp=10.10.10.10
| bucket _time span=1m
| stats count as connection_count by _time, DestinationPort
| where connection_count > 5
| eval detection_name="T1595 — Active Scanning (SYN Scan)"
| eval severity="medium"


# PHASE 2: Initial Access
# Alert on multiple failed SMB logon attempts
index=wineventlog host=DESKTOP-LGU5NRB EventCode=4625
| regex _raw="<EventID>4625</EventID>"
| bucket _time span=5m
| stats count as failed_logons by _time, host
| where failed_logons > 10
| eval detection_name="T1110 — Brute Force (SMB)"
| eval severity="high"


# PHASE 3: Execution
# Alert on PowerShell with IEX (Invoke-Expression)
index=sysmon host=DESKTOP-LGU5NRB EventCode=1 Image="*\powershell.exe" 
CommandLine="*IEX*" OR CommandLine="*DownloadString*"
| table _time host User Image CommandLine ProcessGuid
| eval detection_name="T1059 — Command and Scripting Interpreter (PowerShell IEX)"
| eval severity="high"


# PHASE 4: Privilege Escalation
# Alert on fodhelper UAC bypass (ms-settings registry write)
index=sysmon host=DESKTOP-LGU5NRB EventCode=13 
TargetObject="*ms-settings*Shell*Open*command*"
| table _time host User Image TargetObject
| eval detection_name="T1548 — UAC Bypass (fodhelper)"
| eval severity="critical"


# PHASE 5: Credential Access
# Alert on LSASS process access from non-system process
index=sysmon host=DESKTOP-LGU5NRB EventCode=10 
TargetImage="*\lsass.exe" CallTrace="*comsvcs*"
| table _time host SourceImage TargetImage CallTrace ProcessGuid
| eval detection_name="T1555 — LSASS Memory Dump"
| eval severity="critical"


# PHASE 6: Persistence
# Alert on Run registry key modifications
index=sysmon host=DESKTOP-LGU5NRB EventCode=13 
TargetObject="*CurrentVersion*Run*"
| table _time host User Image TargetObject Details
| eval detection_name="T1547 — Persistence (Run Registry)"
| eval severity="high"


# PHASE 7: Defense Evasion
# Alert on event log clearing (EID 1102)
index=wineventlog host=DESKTOP-LGU5NRB EventCode=1102
| regex _raw="<EventID>1102</EventID>"
| table _time host User EventCode
| eval detection_name="T1070 — Indicator Removal (Clear Event Logs)"
| eval severity="critical"


# PHASE 8: Discovery
# Alert on LOLBin discovery commands (net, tasklist, whoami, systeminfo)
index=sysmon host=DESKTOP-LGU5NRB EventCode=1
Image="*\net.exe" OR Image="*\tasklist.exe" OR Image="*\whoami.exe" OR Image="*\systeminfo.exe"
| bucket _time span=2m
| stats count as discovery_count by _time, host
| where discovery_count >= 3
| eval detection_name="T1087 — Account Discovery + T1018 — Remote System Discovery"
| eval severity="medium"


# PHASE 9: Collection
# Alert on archive file creation in writable directories
index=sysmon host=DESKTOP-LGU5NRB EventCode=11 
TargetFilename="*.zip" TargetFilename="*\Public\*" OR TargetFilename="*\Temp\*"
| table _time host Image TargetFilename
| eval detection_name="T1560 — Archive Collected Data"
| eval severity="medium"


# PHASE 10: Exfiltration
# Alert on outbound HTTP POST to attacker infrastructure
index=sysmon host=DESKTOP-LGU5NRB EventCode=3 
DestinationPort=8444 OR DestinationPort=8443
DestinationIp="10.10.10.5"
| table _time host Image DestinationIp DestinationPort
| eval detection_name="T1041 — Exfiltration Over C2 Channel"
| eval severity="critical"


# PHASE 11: Impact
# Alert on VSS (Volume Shadow Copy) deletion (ransomware indicator)
index=sysmon host=DESKTOP-LGU5NRB EventCode=1 
Image="*\vssadmin.exe" CommandLine="*delete*shadows*"
| table _time host User Image CommandLine ProcessGuid
| eval detection_name="T1490 — Inhibit System Recovery (VSS Deletion)"
| eval severity="critical"


# ============================================
# SETUP INSTRUCTIONS FOR SPLUNK
# ============================================
# 1. Copy the Master Correlation Search (first query block)
# 2. In Splunk, go to Search > New Search
# 3. Paste the query into the search box
# 4. Set Time Range to "Last 24 hours"
# 5. Click Search
# 6. To save as a report:
#    - Click "Save As" > Report
#    - Name: "Multi-Stage MITRE Attack Chain"
#    - Save to: "Search & Reporting" app
# 7. To create an alert:
#    - Click "Save As" > Alert
#    - Search schedule: Run on cron 0 * * * * (hourly)
#    - Alert action: Send email / Create incident / etc.

# ============================================
# EXPECTED OUTPUT
# ============================================
# For a successful end-to-end attack:
# host              stages_hit  stage_list                                      total_events  duration_minutes
# DESKTOP-LGU5NRB   8           01_recon, 02_initial_access, 03_execution ...   234           45.5

